# ── IBM Watson Assistant ──────────────────────────────────────
# Obtenha estes valores em cloud.ibm.com → sua instância do Watson Assistant
# → "Service credentials" (API Key / URL) e, no Assistant, em
# "Assistant settings" → "Assistant IDs and API details" (Assistant ID).
WATSON_API_KEY=sua_api_key_aqui
WATSON_SERVICE_URL=https://api.us-south.assistant.watson.cloud.ibm.com
WATSON_ASSISTANT_ID=seu_assistant_id_aqui

# ── Modo de operação ──────────────────────────────────────────
# auto   → usa Watson se as credenciais acima estiverem preenchidas;
#          cai para o mock local caso contrário (ver seção 11 do plano)
# watson → força o uso do Watson (erro se credenciais ausentes)
# mock   → força o assistente mock local (demonstração sem nuvem)
ASSISTANT_MODE=auto

# ── Flask ─────────────────────────────────────────────────────
FLASK_SECRET_KEY=cardio-ia-secret-key-2026
FLASK_DEBUG=True
FLASK_PORT=5000
